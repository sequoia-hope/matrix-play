  (condition "A.NetName == '/Driver 4 and matrix/SW4_11'")
  (constraint track_width (min 0.10mm)))

(rule "/Driver 4 and matrix/SW4_2 width"
  (condition "A.NetName == '/Driver 4 and matrix/SW4_2'")
  (constraint track_width (min 0.10mm)))

(rule "/Driver 4 and matrix/SW4_3 width"
  (condition "A.NetName == '/Driver 4 and matrix/SW4_3'")
  (constraint track_width (min 0.10mm)))

(rule "/Driver 4 and matrix/SW4_4 width"
  (condition "A.NetName == '/Driver 4 and matrix/SW4_4'")
  (constraint track_width (min 0.10mm)))

