  (condition "A.NetName == '/Driver 3 and matrix/SW3_7'")
  (constraint track_width (min 0.10mm)))

(rule "/Driver 3 and matrix/SW3_8 width"
  (condition "A.NetName == '/Driver 3 and matrix/SW3_8'")
  (constraint track_width (min 0.10mm)))

(rule "/Driver 3 and matrix/SW3_9 width"
  (condition "A.NetName == '/Driver 3 and matrix/SW3_9'")
  (constraint track_width (min 0.10mm)))

(rule "/Driver 4 and matrix/SW4_1 width"
  (condition "A.NetName == '/Driver 4 and matrix/SW4_1'")
  (constraint track_width (min 0.10mm)))

(rule "/Driver 4 and matrix/SW4_10 width"
  (condition "A.NetName == '/Driver 4 and matrix/SW4_10'")
