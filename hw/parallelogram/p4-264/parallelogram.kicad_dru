  (condition "A.NetName == '/Driver 3 and matrix/SW3_1'")
  (constraint track_width (min 0.10mm)))

(rule "/Driver 3 and matrix/SW3_10 width"
  (condition "A.NetName == '/Driver 3 and matrix/SW3_10'")
  (constraint track_width (min 0.10mm)))

(rule "/Driver 3 and matrix/SW3_11 width"
  (condition "A.NetName == '/Driver 3 and matrix/SW3_11'")
  (constraint track_width (min 0.10mm)))

(rule "/Driver 3 and matrix/SW3_2 width"
  (condition "A.NetName == '/Driver 3 and matrix/SW3_2'")
  (constraint track_width (min 0.10mm)))

(rule "/Driver 3 and matrix/SW3_3 width"
  (condition "A.NetName == '/Driver 3 and matrix/SW3_3'")
  (constraint track_width (min 0.10mm)))

